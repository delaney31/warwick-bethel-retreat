# Required — PostgreSQL (Neon recommended for Vercel)
DATABASE_URL=postgresql://user:password@host:5432/warwick_bethel_retreat?sslmode=require

# Required — public site URL (metadata, Stripe redirects, payment links, sitemap)
# Production: https://tuxedoretreat.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional (production) ---

# Host admin dashboard (/admin) — min 8 characters
ADMIN_PASSWORD=change-me-to-a-strong-secret

# Stripe Checkout — required for host approval → guest payment flow
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Host alerts when a guest submits a booking request (Resend — same account/key as Pacific Luxe)
# RESEND_API_KEY=re_xxxx
# EMAIL_FROM=Tuxedo Retreat <stays@pacificluxrentals.com>
# HOST_ALERT_EMAIL=pacificluxerentals@gmail.com

# Twilio SMS host alerts (optional — parallel to email)
# ENABLE_TWILIO_SMS=true
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# HOST_ALERT_PHONE=

# NEXT_PUBLIC_APP_NAME=Tuxedo Retreat
