# PostgreSQL (Neon, local Docker, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/warwick_bethel_retreat?sslmode=require

# Public site URL (emails, metadata, Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Warwick Bethel Retreat

# Host admin dashboard (/admin) — min 8 characters
ADMIN_PASSWORD=change-me-to-a-strong-secret

# Stripe Checkout (approve → payment; webhook confirms PAID_CONFIRMED)
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx

# Optional: legacy ASP.NET API (admin documents/payments if still on Render)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5002
INTERNAL_API_URL=http://localhost:5002

# Production: https://warwick-bethel-retreat.vercel.app
# Production API: https://warwick-bethel-retreat.onrender.com
