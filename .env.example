# Required — PostgreSQL (Neon recommended for Vercel)
DATABASE_URL=postgresql://user:password@host:5432/warwick_bethel_retreat?sslmode=require

# Required — public site URL (metadata, Stripe redirects, emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional (production) ---

# Host admin dashboard (/admin) — min 8 characters
ADMIN_PASSWORD=change-me-to-a-strong-secret

# Stripe Checkout — required for host approval → guest payment flow
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# NEXT_PUBLIC_APP_NAME=Warwick Bethel Retreat
