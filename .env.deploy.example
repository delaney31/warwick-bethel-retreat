# Copy to .env.deploy (gitignored) and fill in values.
# Then run: ./scripts/bootstrap-warwick-production.sh
#
# Reuse the SAME Neon / Vercel / Render accounts as Pacific Luxe Direct.

# ─── Neon (NEW database for retreat — not the Pacific Luxe vehicle DB) ───
NEON_DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/warwick_bethel_retreat?sslmode=require

# ─── Render (filled after blueprint deploy, or existing retreat service) ───
RENDER_API_URL=https://warwick-retreat-api.onrender.com

# ─── Vercel (from dashboard → project Settings, or after first deploy) ───
VERCEL_TOKEN=
VERCEL_ORG_ID=team_xxxx
VERCEL_PROJECT_ID=prj_xxxx
VERCEL_PRODUCTION_URL=https://warwick-bethel-retreat.vercel.app

# ─── Optional: same Stripe as Pacific Luxe ───
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxx

# ─── JWT (optional — Render blueprint can auto-generate on first deploy) ───
JWT_SIGNING_KEY=
